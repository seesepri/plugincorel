<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CorelPageCopier</RootNamespace>
    <AssemblyName>CorelPageCopier</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <StartupObject>CorelPageCopier.Program</StartupObject>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputPath>bin\Release\</OutputPath>
    <ProjectGuid>{9479C106-F1C5-37A4-06A6-D94DE2AF95DA}</ProjectGuid>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Runtime.InteropServices" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="WatermarkLayout.vb" />
    <Compile Include="WatermarkEngine.vb" />
    <Compile Include="WatermarkDialog.vb" />
  </ItemGroup>
  <ItemGroup>
    <!-- Logo bawaan untuk fitur watermark (PNG transparan, ikut tertanam di EXE). -->
    <EmbeddedResource Include="assets\seta-logo.png" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
</Project>