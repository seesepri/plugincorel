<Project Sdk="Microsoft.NET.Sdk">

  <!--
    COMPILE-CHECK SAJA (bukan pengganti build rilis).

    Tujuan: memvalidasi sintaks + resolusi tipe seluruh file produksi terhadap
    .NET Framework 4.8 tanpa membutuhkan Windows/MSBuild. Berguna di CI Linux
    atau saat review di lingkungan non-Windows.

    Proyek ini TIDAK menghasilkan EXE rilis. Build rilis tetap:
        msbuild CorelPageCopier/CorelPageCopier.vbproj /t:Rebuild /p:Configuration=Release /p:Platform=x64

    Jalankan:
        dotnet build tests/CorelPageCopier.CompileCheck/CorelPageCopier.CompileCheck.vbproj -c Release
    Exit code 0 + "Build succeeded" = semua file produksi berhasil dikompilasi.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>CorelPageCopier</RootNamespace>
    <AssemblyName>CorelPageCopier.CompileCheck</AssemblyName>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\CorelPageCopier\*.vb" Link="Source\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\CorelPageCopier\assets\*.png" Link="assets\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Runtime.InteropServices" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
